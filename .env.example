# Supabase — required (BE-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: webhook handlers and background workers (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Channel3 product search (BE-3). When unset, searchProducts() uses the local
# fallback catalog — the app works offline for demos and local dev.
CHANNEL3_API_KEY=

# OpenAI (BE-5). Required for POST /api/chat; the route returns 503 without it.
OPENAI_API_KEY=
