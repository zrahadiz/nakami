# Supabase — required (BE-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: webhook handlers and background workers (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Channel3 product search (BE-3). When unset, searchProducts() uses the local
# fallback catalog — the app works offline for demos and local dev.
CHANNEL3_API_KEY=

# OpenAI (BE-5). Required for POST /api/chat; the route returns 503 without it.
OPENAI_API_KEY=

# fal.ai 3D generation (T4/T5). Server-only — never expose as NEXT_PUBLIC_*.
# Required for real generations; POST /api/jobs returns 503 without it AND
# without the dev mock (below).
FAL_KEY=

# Mock 3D generation (dev/demo) from the CC0 samples in public/models.
# Seed them into Storage once with `bun run seed:samples` (glb-cache/samples):
#   unset -> mock only when FAL_KEY is missing and NODE_ENV != production
#   1     -> force mock (never in production)   |   0 -> never mock
FAL_MOCK=
# Total mock generation time in ms (default 6000; 0 = resolve instantly).
FAL_MOCK_DELAY_MS=

# PayPal multi-seller checkout. Server-only — never expose as NEXT_PUBLIC_*.
# Without the credentials the app still works: checkout routes answer 503,
# exactly like CHANNEL3_API_KEY for search.
#
# One platform REST app creates/captures orders; each product's OWN sandbox
# business account is attached as the purchase-unit payee (multi-seller
# payments). Create the accounts on developer.paypal.com, list them in
# scripts/paypal-merchants.json, seed with `bun run seed:merchants`.
# PAYPAL_ENV: sandbox (default) | live.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal-Partner-Attribution-Id (BN code) for platform attribution. Optional.
PAYPAL_BN_CODE=
# Webhook id for /api/webhooks/paypal signature verification. Required for
# webhooks once registered in the developer dashboard.
PAYPAL_WEBHOOK_ID=
# Fallback payee when no paypal_merchants row matches a product or retailer.
PAYPAL_DEFAULT_MERCHANT_ID=
PAYPAL_DEFAULT_MERCHANT_EMAIL=
