# Supabase — required (BE-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: webhook handlers and background workers (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Channel3 product search (BE-3). When unset, searchProducts() uses the local
# fallback catalog — the app works offline for demos and local dev.
CHANNEL3_API_KEY=

# OpenAI (BE-5). Required for POST /api/chat; the route returns 503 without it.
OPENAI_API_KEY=

# fal.ai 3D generation (T4/T5). Server-only — never expose as NEXT_PUBLIC_*.
# Required for real generations; POST /api/jobs returns 503 without it AND
# without the dev mock (below).
FAL_KEY=

# Mock 3D generation (dev/demo) from the CC0 samples in public/models.
# Seed them into Storage once with `bun run seed:samples` (glb-cache/samples):
#   unset -> mock only when FAL_KEY is missing and NODE_ENV != production
#   1     -> force mock (never in production)   |   0 -> never mock
FAL_MOCK=
# Total mock generation time in ms (default 6000; 0 = resolve instantly).
FAL_MOCK_DELAY_MS=
